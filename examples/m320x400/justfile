build-web:
	wasm-pack build --debug --target web --features web

build-sdl3:
    cargo build --features sdl3

build-sdl2:
    cargo build --features sdl2

build-all:
    cargo build --features all

run-web: build-web
	miniserve ./

run-sdl3:
	cargo run --features sdl3 -- sdl3

run-sdl2:
	cargo run --features sdl2 -- sdl2
